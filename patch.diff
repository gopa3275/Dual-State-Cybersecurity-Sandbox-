+
+@sqli_bp.route('/')
+def index():
+    # page requires live logs
+    return render_template('features/sqli.html', show_live_logs=True)
+
+@sqli_bp.route('/api/scan', methods=['POST'])
+def scan():
+    """
+    Expected: request.json contains { input: '...' }
+    Returns a consistent shape:
+      { status: 'ok'|'error', blocked: bool, message: str, telemetry: {...}, data: {...} }
+    """
+    try:
+      payload = request.json or {}
+      user_input = payload.get('input', '')
+      # Setup DB, run simulated query
+      db = init_sqli_db()
+
+      # mode determination - reuse whatever global/session toggle exists
+      secure = session.get('security_on', True)
+      if secure:
+        # Create prepared query representation (no leaked rows)
+        prepared_query = "SELECT id, username FROM users WHERE username = ?"
+        bound_values = [user_input]
+        data = {
+          'mode': 'secure',
+          'prepared_query': prepared_query,
+          'bound_values': bound_values,
+          'leaked_rows': []
+        }
+        inc_telemetry_blocked()  # increment attacks_blocked
+        status = 'ok'
+        blocked = True
+        msg = 'Secure mode executed (parameterized).'
+      else:
+        # Vulnerable concatenation (simulate leak)
+        raw_query = "SELECT id, username FROM users WHERE username = '%s'" % user_input
+        # Simulate AST tokens and leaked rows
+        leaked = [{'id': 1, 'username': 'alice'}, {'id': 2, 'username': 'bob'}] if "' OR '1'='1" in user_input else []
+        data = {
+          'mode': 'vulnerable',
+          'raw_query': raw_query,
+          'ast': {'type': 'concat', 'tokens': ['SELECT','WHERE','concat']},
+          'leaked_rows': leaked
+        }
+        if leaked:
+          inc_telemetry_exploited()
+        status = 'ok'
+        blocked = False
+        msg = 'Vulnerable mode executed.'
+
+      telemetry = get_session_telemetry()
+      return jsonify({'status': status, 'blocked': blocked, 'message': msg, 'telemetry': telemetry, 'data': data})
+    except Exception as e:
+      telemetry = get_session_telemetry()
+      return jsonify({'status': 'error', 'blocked': False, 'message': str(e), 'telemetry': telemetry, 'data': {}}), 500

+<!-- Live Logs / Telemetry sidebar: render only on interactive lab pages -->
+{% if show_live_logs %}
+<aside id="liveLogsSidebar" class="sidebar" aria-label="Live logs and telemetry">
+  <h3>Live Logs</h3>
+  <div id="liveLogs" class="logs" role="log" aria-live="polite" aria-relevant="additions"></div>
+  <!-- telemetry snapshot area (kept small, updated from applyTelemetryPayload) -->
+  <div id="telemetrySnapshot" class="telemetry-snapshot" aria-hidden="false"></div>
+</aside>
+{% endif %}
+
+<!-- Global accessibility region for copy / small announcements -->
+<div id="ariaLive" class="sr-only" aria-live="polite" aria-atomic="true"></div>
+
+<!-- Global helpers inserted near the bottom of the base template -->
+<script>
+/* Global: addLogEntry(moduleName, message, status)
+   - moduleName: string (e.g., 'sqli', 'xss')
+   - message: string
+   - status: 'exploited' | 'defense' | 'info' (affects badge)
+   Prepends a formatted log entry to #liveLogs if present */
+window.addLogEntry = function(moduleName, message, status) {
+  try {
+    var logs = document.getElementById('liveLogs');
+    if (!logs) return; // No-op if live logs are not present on this page
+
+    var now = new Date();
+    var ts = now.toLocaleString();
+
+    var badgeText = '[INFO]';
+    var badgeClass = 'log-badge-info';
+    if (status === 'exploited') { badgeText = '[EXPLOITED]'; badgeClass = 'log-badge-danger'; }
+    else if (status === 'defense') { badgeText = '[DEFENSE TRIGGERED]'; badgeClass = 'log-badge-success'; }
+
+    var entry = document.createElement('div');
+    entry.className = 'log-entry';
+    entry.innerHTML =
+      '<span class="log-ts">' + ts + '</span> ' +
+      '<span class="log-badge ' + badgeClass + '">' + badgeText + '</span> ' +
+      '<strong>' + (moduleName || 'core') + '</strong>: ' +
+      '<span class="log-msg">' + (message || '') + '</span>';
+
+    // Prepend so latest appear at top (if prepend not supported, fallback to insertBefore)
+    if (logs.firstChild) logs.insertBefore(entry, logs.firstChild);
+    else logs.appendChild(entry);
+  } catch (e) { console.error('addLogEntry failed', e); }
+};
+
+/* Lightweight telemetry result application helper (client-side) — used by dynamic UI code */
+window.applyTelemetryPayload = window.applyTelemetryPayload || function(t) {
+  try {
+    if (!t) return;
+    // Example: update a telemetry snapshot element and optionally topbar badges
+    var el = document.getElementById('telemetrySnapshot');
+    if (el) {
+      el.innerHTML = '<div class="telemetry-row">Attacks blocked: <strong>' + (t.attacks_blocked||0) + '</strong></div>' +
+                     '<div class="telemetry-row">Flaws exploited: <strong>' + (t.flaws_exploited||0) + '</strong></div>';
+    }
+    // Optionally update topbar counters if those elements exist
+    var tb = document.getElementById('topbarAttacksBlocked');
+    if (tb) tb.textContent = t.attacks_blocked || 0;
+    var tf = document.getElementById('topbarFlawsExploited');
+    if (tf) tf.textContent = t.flaws_exploited || 0;
+  } catch(e) { console.error('applyTelemetryPayload failed', e); }
+};
+</script>
+
